APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://trip_os:trip_os_dev_password@localhost:5432/trip_os?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=change-me-to-a-long-random-value
